{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pttangent.local/schemas/sec-llm-review-v1.json",
  "title": "SEC LLM Semantic Review Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "run_id",
    "batch_id",
    "candidate_reason",
    "primary_evidence_id",
    "corroborating_evidence_ids",
    "security_id",
    "issuer_id",
    "symbol",
    "filing_id",
    "accession",
    "form",
    "signal_timestamp",
    "source_available_at",
    "source_available_at_precision",
    "action",
    "claim_class",
    "subject_key",
    "explicitness",
    "confidence",
    "status",
    "rationale",
    "limitations",
    "reviewer",
    "prompt_hash",
    "taxonomy_version",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "sec-llm-review-v1"},
    "review_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "reviewed_assertion_id": {"type": ["string", "null"]},
    "reviewed_relation_id": {"type": ["string", "null"]},
    "candidate_reason": {
      "enum": [
        "product_lifecycle_state",
        "mixed_actual_estimate_risk",
        "relation_role_refinement",
        "relation_scope_missing",
        "disclosure_delta",
        "segment_comparability",
        "legal_remedy_decomposition",
        "taxonomy_candidate",
        "false_positive_correction"
      ]
    },
    "primary_evidence_id": {"type": "string", "minLength": 1},
    "corroborating_evidence_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "security_id": {"type": "string", "minLength": 1},
    "issuer_id": {"type": "string", "minLength": 1},
    "symbol": {"type": "string", "minLength": 1},
    "filing_id": {"type": "string", "minLength": 1},
    "accession": {"type": "string", "minLength": 1},
    "form": {"type": "string", "minLength": 1},
    "signal_timestamp": {"type": "string", "format": "date-time"},
    "source_available_at": {"type": "string", "format": "date-time"},
    "source_available_at_precision": {
      "enum": ["datetime", "date", "derived"]
    },
    "action": {
      "enum": [
        "accept",
        "reject",
        "supersede",
        "create_candidate",
        "no_change",
        "taxonomy_candidate"
      ]
    },
    "claim_class": {
      "enum": [
        "reported_fact",
        "management_estimate",
        "risk_hypothesis",
        "policy_or_rule",
        "management_interpretation",
        "third_party_statement",
        "reviewer_inference"
      ]
    },
    "subject_key": {"type": "string", "minLength": 1},
    "predicate": {"type": ["string", "null"]},
    "object": {"type": ["object", "null"]},
    "explicitness": {"enum": ["explicit", "estimated", "inferred"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"const": "review_required"},
    "effective_from": {"type": ["string", "null"], "format": "date-time"},
    "effective_to": {"type": ["string", "null"], "format": "date-time"},
    "delta_class": {
      "type": ["string", "null"],
      "enum": [
        "new",
        "removed",
        "intensified",
        "de_intensified",
        "unchanged",
        "wording_only",
        "not_comparable",
        null
      ]
    },
    "rationale": {"type": "string", "minLength": 1, "maxLength": 600},
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "model_version", "temperature"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "model_version": {"type": "string", "minLength": 1},
        "temperature": {"type": "number", "minimum": 0}
      }
    },
    "prompt_hash": {"type": "string", "minLength": 16},
    "taxonomy_version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"enum": ["accept", "reject", "supersede"]}}},
      "then": {
        "anyOf": [
          {"required": ["reviewed_assertion_id"]},
          {"required": ["reviewed_relation_id"]}
        ]
      }
    },
    {
      "if": {"properties": {"action": {"enum": ["supersede", "create_candidate"]}}},
      "then": {"required": ["predicate", "object"]}
    }
  ]
}
